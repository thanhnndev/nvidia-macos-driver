+			(need_pipe_sync ? 4u : 0u) | (amdgpu_vmid_had_gpu_reset(adev, id) ? 8u : 0u) |
+			(gds_switch_needed ? 16u : 0u));
+	}
 
 	if (!vm_flush_needed && !gds_switch_needed && !need_pipe_sync &&
 	    !(job->enforce_isolation && !job->vmid))
