+/*
+ * ga403wm 2026-11-19 (BOOT-TIMELINE 4): VTDecoderXPCService [19187] hung 2 h 14 min in amdgpu_vm_fini+0x105 on out-37,
+ * the wait for vm->last_tlb_flush, with every scheduler idle and no ring timeout logged: a page-table job that never
+ * reached a ring. To name it the next time: the wait stays unbounded (freeing page tables while a job may still write
+ * them is worse than a stuck exit), but after 5 s, then every 60 s, the fence, its scheduler state, the VM's two
+ * page-table entities (queue, stopped, the dependency they wait on) and the root's unsignalled fences are logged.
+ * The root reservation is held here, so the root's fence list is stable. A scheduler fence's hardware fence and an
+ * entity's dependency are put and cleared by the scheduler without our locks (drm_sched_stop, the dependency
+ * callback): each is read once under RCU with a reference (fences are freed through RCU), then put.
+ */
+/* a reference to *slot taken under RCU, or NULL: the scheduler puts and clears these pointers without our locks */
+static struct dma_fence *nmx_vm_fence_snap(struct dma_fence **slot)
+{
+	struct dma_fence *f;
+
+	rcu_read_lock();
+	f = READ_ONCE(*slot);
+	if (f)
+		f = dma_fence_get_rcu(f);
+	rcu_read_unlock();
+	return f;
 }
