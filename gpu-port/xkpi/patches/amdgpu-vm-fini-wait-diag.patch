+struct dma_fence *amdgpu_tlb_fence_dependency(struct dma_fence *fence);
+struct dma_fence *amdgpu_tlb_fence_dependency(struct dma_fence *fence)
+{
+	struct amdgpu_tlb_fence *f;
+	struct dma_fence *dep;
+
+	if (!fence || fence->ops != &amdgpu_tlb_fence_ops)
+		return NULL;
+	f = container_of(fence, struct amdgpu_tlb_fence, base);
+	rcu_read_lock();
+	dep = READ_ONCE(f->dependency);
+	if (dep)
+		dep = dma_fence_get_rcu(dep);
+	rcu_read_unlock();
+	return dep;
+}
+#endif
