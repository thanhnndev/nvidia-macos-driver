+/*
+ * ga403wm Step95: every failing stage of a command submission says which one failed and with what. A CS rejected
+ * from deep inside amdgpu_cs_ioctl reaches user space as one errno (the Step96/97b WindowServer crash loops were
+ * "CS rejected (-1)" with no other line). -EAGAIN, -ERESTARTSYS and -EINTR are normal and not logged. Budgets: 96
+ * lines for -EPERM, 48 for other errors.
+ */
+void nmx_cs_report_name(const char *what, int r, bool always)
+{
+	static atomic_t eperm, other;
+
+	if (!always && (r == 0 || r == -EAGAIN || r == -ERESTARTSYS || r == -EINTR || r == -EDEADLK))
+		return;
+	if (atomic_inc_return(r == -EPERM ? &eperm : &other) > (r == -EPERM ? 96 : 48))
+		return;
+	printf("NMX cs-trace: %s -> %d\n", what, r);
+}
