--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_dev_coredump.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_dev_coredump.c
@@ -28,9 +28,29 @@
 #include "atom.h"
 
 #ifndef CONFIG_DEV_COREDUMP
+/* the port's printf has no %pV, so drm_info_printer would print the va_format pointer: format the line here */
+static void nmx_ipdump_printfn(struct drm_printer *p, struct va_format *vaf)
+{
+	char line[200];
+	int n;
+
+	vsnprintf(line, sizeof(line), vaf->fmt, *vaf->va);
+	for (n = strlen(line); n > 0 && (line[n - 1] == '\n' || line[n - 1] == ' ' || line[n - 1] == '\t'); n--)
+		line[n - 1] = 0;
+	if (n)
+		printf("NullMoth ipdump: %s\n", line);
+}
+
 void amdgpu_coredump(struct amdgpu_device *adev, bool skip_vram_check,
 		     bool vram_lost, struct amdgpu_job *job)
 {
+	/* NullMoth: no devcoredump on xnu - print the IP state a job timeout captured (GRBM/CP/RLC registers) to the log */
+	struct drm_printer p = { .printfn = nmx_ipdump_printfn };
+	int i;
+
+	for (i = 0; i < adev->num_ip_blocks; i++)
+		if (adev->ip_blocks[i].version->funcs->print_ip_state)
+			adev->ip_blocks[i].version->funcs->print_ip_state(&adev->ip_blocks[i], &p);
 }
 #else
 
