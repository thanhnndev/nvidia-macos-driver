diff -u -r b14old/drivers/gpu/drm/amd/amdgpu/amdgpu_ib.c b14new/drivers/gpu/drm/amd/amdgpu/amdgpu_ib.c
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_ib.c	2026-10-19 20:38:59
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_ib.c	2026-10-19 20:38:59
@@ -35,8 +35,46 @@
 #include "atom.h"
 #include "amdgpu_trace.h"
 
+/*
+ * NullMoth b14: a user IB has no kernel pointer (ib->ptr is NULL) and its dwords reach memory through the process's
+ * own mapping. Push the IB's lines out before the CP fetches them, and say which IB each submission carries, so a
+ * stuck job can be matched to the PM4 the CP was asked to run.
+ */
+static void nmx_ib_prepare(struct amdgpu_job *job, struct amdgpu_ib *ib)
+{
+	struct amdgpu_bo_va_mapping *m;
+	struct amdgpu_bo *bo;
+	void *kaddr = NULL;
+	u64 off;
+	u32 i;
 
+	if (!job || !job->vm || !ib->length_dw || ib->ptr || !ib->gpu_addr)
+		return;
 
+	m = amdgpu_vm_bo_lookup_mapping(job->vm, ib->gpu_addr >> PAGE_SHIFT);
+	if (!m || !m->bo_va || !m->bo_va->base.bo)
+		return;
+	bo = m->bo_va->base.bo;
+
+	off = m->offset + (ib->gpu_addr - (m->start << PAGE_SHIFT));
+	if (amdgpu_bo_kmap(bo, &kaddr) || !kaddr)
+		return;
+
+	{
+		char *p = (char *)kaddr + off;
+
+		for (i = 0; i < ib->length_dw * 4; i += 64)
+			__asm__ __volatile__("clflush (%0)" : : "r"(p + i) : "memory");
+		mb();
+		printf("NullMoth ibsub: vmid %u pasid %u va %llx len %u off %llx first %08x %08x %08x %08x %08x\n",
+		       job->vmid, job->pasid, (unsigned long long)ib->gpu_addr, ib->length_dw,
+		       (unsigned long long)off, ((u32 *)p)[0], ((u32 *)p)[1], ((u32 *)p)[2],
+		       ((u32 *)p)[3], ((u32 *)p)[4]);
+	}
+	amdgpu_bo_kunmap(bo);
+}
+
+
