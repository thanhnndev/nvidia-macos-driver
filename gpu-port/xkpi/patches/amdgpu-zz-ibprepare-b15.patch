+/* NMX b15: prepare CPU-authored GFX IBs while CS still owns the VM and
+ * BO reservations. job->vm is cleared by prepare_job before run_job, so
+ * the former amdgpu_ib_schedule hook could never reach a user IB.
+ */
+static int nmx_cs_prepare_ibs(struct amdgpu_cs_parser *p,
+			      struct amdgpu_job *job)
+{
+	unsigned int i;
+
+	if (amdgpu_job_ring(job)->funcs->type != AMDGPU_RING_TYPE_GFX)
+		return 0;
+	for (i = 0; i < job->num_ibs; ++i) {
+		struct amdgpu_ib *ib = &job->ibs[i];
+		struct amdgpu_bo_va_mapping *m;
+		struct amdgpu_bo *bo;
+		u64 va = ib->gpu_addr & AMDGPU_GMC_HOLE_MASK;
+		u64 bytes = (u64)ib->length_dw * sizeof(u32), delta, off, pos;
+		void *kaddr;
+		char *data;
+		int r;
+
+		if (ib->ptr || !bytes)
+			continue;
+		r = amdgpu_cs_find_mapping(p, va, &bo, &m);
+		if (r)
+			return r;
+		/* Validate both the VA mapping and the underlying BO before kmap.
+		 * All arithmetic is 64-bit; subtraction avoids end overflow. */
+		delta = va - (m->start << AMDGPU_GPU_PAGE_SHIFT);
+		if (bytes > ((m->last + 1) << AMDGPU_GPU_PAGE_SHIFT) - va ||
+		    m->offset > amdgpu_bo_size(bo) ||
+		    delta > amdgpu_bo_size(bo) - m->offset)
+			return -EINVAL;
+		off = m->offset + delta;
+		if (bytes > amdgpu_bo_size(bo) - off)
+			return -EINVAL;
+		r = amdgpu_bo_kmap(bo, &kaddr);
+		if (r)
+			return r;
+		if (!kaddr) {
+			amdgpu_bo_kunmap(bo);
+			return -EFAULT;
+		}
+		data = (char *)kaddr + off;
+		/* Include the last cache line even for a non-aligned IB start. */
+		for (pos = off & ~63ULL; pos < off + bytes; pos += 64)
+			__asm__ __volatile__("clflush (%0)" : : "r"((char *)kaddr + pos) : "memory");
+		mb();
+		if (!i) {
+			job->nmx_ib_va = ib->gpu_addr;
+			job->nmx_ib_length_dw = ib->length_dw;
+			job->nmx_ib_snapshot_dw = min_t(u32, ib->length_dw, 96);
+			memcpy(job->nmx_ib_snapshot, data, job->nmx_ib_snapshot_dw * sizeof(u32));
+			printf("NullMoth ibprep b15: va %llx len %u off %llx first %08x captured %u\n",
+			       (unsigned long long)ib->gpu_addr, ib->length_dw,
+			       (unsigned long long)off, job->nmx_ib_snapshot[0], job->nmx_ib_snapshot_dw);
+		}
+		amdgpu_bo_kunmap(bo);
+	}
+	return 0;
+}
