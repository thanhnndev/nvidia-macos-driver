+/* ga403wm out-31 trace: the eDP panel link's self-refresh state and the vblank IRQ users, the inputs of
+ * amdgpu_dm_crtc_vblank_control_worker / dcn35_apply_idle_power_optimizations. out[] = psr_feature_enabled,
+ * psr_allow_active, psr_version, replay_feature_enabled, active_vblank_irq_count. -1 without an eDP link. */
+int nmx_dm_psr_flags(struct drm_device *ddev, u32 out[5]);
+int nmx_dm_psr_flags(struct drm_device *ddev, u32 out[5])
+{
+	struct amdgpu_device *adev = drm_to_adev(ddev);
+	struct dc *dc = adev->dm.dc;
+	unsigned int i;
+
+	out[4] = adev->dm.active_vblank_irq_count;
+	if (dc == NULL)
+		return -1;
+	for (i = 0; i < dc->link_count; i++) {
+		struct dc_link *l = dc->links[i];
+
+		if (l == NULL || l->connector_signal != SIGNAL_TYPE_EDP)
+			continue;
+		out[0] = l->psr_settings.psr_feature_enabled;
+		out[1] = l->psr_settings.psr_allow_active;
+		out[2] = (u32)l->psr_settings.psr_version;
+		out[3] = l->replay_settings.replay_feature_enabled;
+		return 0;
+	}
+	return -1;
+}
